{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/youtube-video-downloader",
    "description": "Download videos with yt-dlp and extract YouTube transcripts with Defuddle",
    "version": "1.1.1",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/youtube-video-downloader@1.1.1/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/youtube-video-downloader",
            "version": "1.1.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-youtube-video-downloader",
        "source": "github"
    }
}
