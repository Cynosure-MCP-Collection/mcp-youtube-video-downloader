{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/youtube-video-downloader",
    "description": "Download videos from YouTube, Vimeo, and other sites with yt-dlp progress tracking",
    "version": "1.0.4",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/youtube-video-downloader@1.0.4/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/youtube-video-downloader",
            "version": "1.0.4",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": []
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/Cynosure-MCPs",
        "source": "github",
        "subfolder": "mcp-youtube-video-downloader"
    }
}
