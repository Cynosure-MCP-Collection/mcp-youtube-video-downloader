{
  "name": "@cynosure-mcp/youtube-video-downloader",
  "mcpName": "io.github.andreasjhagen/youtube-video-downloader",
  "version": "1.0.3",
  "description": "MCP server for downloading videos from YouTube, Vimeo, and other sites using yt-dlp with progress tracking",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "youtube-video-downloader": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ytdlp-nodejs": "^3.4.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "video-downloader",
    "yt-dlp",
    "ai"
  ]
}
